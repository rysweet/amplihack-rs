#!/bin/bash -p
# amplihack-gh-merge-guard
#
# gh merge guard (amplihack issue #1551). `amplihack recipe run` puts this
# directory first on PATH for every auto-drive run. A merge attempted anywhere
# but ../autodrive_merge_gate.sh is refused with one fixed stderr line and
# exit 3; every other call is handed to the real gh with `exec`, argv
# unchanged.
#
# Refused: `gh pr merge`, the REST merge endpoints, GraphQL merge mutations,
# GraphQL queries the guard cannot read, aliases that merge, and running or
# installing a gh extension. A merge form
# is allowed only when this process's immediate parent is the trusted gate.
#
# The same five facts are established about that parent on every supported
# host; only the kernel interface that establishes them differs. Linux reads
# /proc. macOS has no /proc, so it reads the kernel's own records through
# `ps`, one `lsof -n -P` call and `stat -f`, and observes the clean-
# environment fact in the environment this shim inherited through the gate's
# `exec`, because macOS exposes no way to read another process's environment
# (#1646). A host that is neither: refused.
#
# Privileged mode (-p): bash neither sources BASH_ENV/ENV nor imports exported
# functions, so neither can answer the identity checks below. This is a
# guardrail for agents that follow instructions, not a sandbox: see
# docs/reference/auto-drive-to-merge.md, "What this does not stop".
# Exit codes: 3 = refused, 127 = no real gh or the re-entry cap was passed.

# Second layer for anything this script starts (SR-4), and the first line of
# defence for the identity checks below: an exported function would otherwise
# be able to answer one of them. Every function this shim defines is dropped
# here, and so is every tool word it runs. A new helper left off this list is
# an authentication bypass, not a hygiene slip, so
# recipes/tests/test-issue-1551-no-merge-outside-gate.sh fails when one is
# missing rather than leaving it a standing risk.
builtin unset -f ps env uname lsof 2>/dev/null  # the Darwin arm's tools; lsof is only ever run as `lsof -n -P`
builtin unset -f refuse to_lower classify classify_pr classify_api classify_alias_cmd \
  classify_alias_use classify_extension_cmd is_merge_endpoint is_graphql_endpoint names_merge find_real_gh carries_marker \
  parent_is_gate parent_is_gate_proc parent_is_gate_darwin parent_pid_matches parent_environ_clean \
  parent_pid_matches_darwin parent_argv_is_gate_darwin parent_files_are_gate_darwin \
  gate_physical_darwin host_is_darwin ps_field txt_entry_ok own_environ_clean \
  sys_tool realpath readlink stat test cd pwd 2>/dev/null

# Fact (e) on a host without /proc is read from the environment this shim
# INHERITED through the gate's `exec` (#1646), so the snapshot has to be taken
# before the `builtin unset` below: that unset also removes BASH_ENV and ENV
# from the environment a child `env` would print, which would hide exactly the
# two names an injection is most likely to use. Variable NAMES are all that is
# ever compared, and nothing from this string is printed, logged or exported
# (DP-1). An `env` that cannot be found or cannot run leaves it empty, which
# refuses every merge on that host rather than passing the fact by default.
GUARD_ENV=""
for _ampl_env in /usr/bin/env /bin/env; do
  if [[ -x "$_ampl_env" ]]; then
    GUARD_ENV="$("$_ampl_env" 2>/dev/null)" || GUARD_ENV=""
    break
  fi
done
builtin unset _ampl_env
builtin unset BASH_ENV ENV
set -uf

MARKER='# amplihack-gh-merge-guard'
DEPTH_CAP=4

# The depth is matched against digits before any arithmetic: bash arithmetic
# on an untrusted string can run commands through an array subscript (SR-5).
depth="${AMPLIHACK_GH_GUARD_DEPTH:-0}"
if ! [[ "$depth" =~ ^[0-9]{1,3}$ ]]; then
  printf 'amplihack gh-merge-guard: invalid AMPLIHACK_GH_GUARD_DEPTH\n' >&2
  exit 127
fi
depth=$((10#$depth + 1))
if (( depth > DEPTH_CAP )); then
  printf 'amplihack gh-merge-guard: re-entry cap passed; is another gh wrapper calling back into this one?\n' >&2
  exit 127
fi
export AMPLIHACK_GH_GUARD_DEPTH="$depth"

self="${BASH_SOURCE[0]}"
[[ "$self" == */* ]] || self="./$self"
SELF_DIR="$(builtin cd -P -- "${self%/*}" 2>/dev/null && builtin pwd -P)" || SELF_DIR=""

UNKNOWN_CLASS='unknown gh command or extension'

refuse() { # refuse <label>: the fixed line, never argv (DP-1)
  if [[ "$1" == "$UNKNOWN_CLASS" ]]; then
    # Not necessarily a merge: a word that is neither in classify()'s list of
    # built-in commands nor an alias. It may be an extension (its own code,
    # which could merge without this guard) or a command a newer gh added.
    printf 'REFUSED (amplihack #1551): unknown gh command or extension — the first word is not a built-in command in the merge guard'"'"'s allowlist (classify() in amplifier-bundle/tools/gh-merge-guard/gh) and not a gh alias. Extensions run their own code and could merge past this guard, so auto-drive refuses them. If a newer gh added this command, add it to that allowlist.\n' >&2
    exit 3
  fi
  printf 'REFUSED (amplihack #1551): %s is only allowed inside autodrive_merge_gate.sh; leave the PR open — auto-drive'"'"'s merge gate merges after Crusty CLEAN and the merge-ready loop. Do not retry with another gh path, PATH, alias, API client or token.\n' "$1" >&2
  exit 3
}

# carries_marker <file>: a script holding the marker line is another copy of
# this shim. A binary (no #!) never is.
carries_marker() {
  local head="" line
  IFS= read -r -n 2 head < "$1" 2>/dev/null || return 1
  [[ "$head" == '#!' ]] || return 1
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ "$line" == "$MARKER" ]] && return 0
  done < "$1"
  return 1
}

# find_real_gh: the first executable gh on PATH, considering absolute entries
# only (SR-1), skipping this shim's directory and any copy of the shim.
find_real_gh() {
  local -a dirs=()
  local d phys
  IFS=: read -r -a dirs <<< "${PATH:-}"
  for d in "${dirs[@]}"; do
    [[ "$d" == /* ]] || continue
    # Cheap test first: resolving the physical path forks a subshell, so only
    # do it for entries that actually hold an executable gh.
    [[ -f "$d/gh" && -x "$d/gh" ]] || continue
    phys="$(builtin cd -P -- "$d" 2>/dev/null && builtin pwd -P)" || continue
    [[ -n "$SELF_DIR" && "$phys" == "$SELF_DIR" ]] && continue
    carries_marker "$d/gh" && continue
    REAL_GH="$d/gh"
    return 0
  done
  return 1
}

# sys_tool <name>: a system tool by absolute path, never through PATH.
# /usr/sbin is appended LAST, for macOS's lsof, so that no name this shim
# already resolved can start resolving somewhere else.
sys_tool() {
  local d
  for d in /usr/bin /bin /usr/sbin; do
    [[ -x "$d/$1" ]] && { printf '%s' "$d/$1"; return 0; }
  done
  return 1
}

# parent_pid_matches: /proc/self/stat field 4 (read after the last ')', since
# comm may hold spaces or parentheses) must still be $PPID, so a shim whose
# parent exited and whose pid was reused is never judged by a stranger (G12).
parent_pid_matches() {
  local line rest
  local -a f=()
  IFS= read -r line < /proc/self/stat 2>/dev/null || return 1
  [[ "$line" == *')'* ]] || return 1
  rest="${line##*)}"
  read -r -a f <<< "$rest"
  (( ${#f[@]} >= 2 )) || return 1
  [[ "${f[1]}" =~ ^[0-9]+$ && "${f[1]}" == "$PPID" ]]
}

# parent_environ_clean <proc>: the parent was started with no exported
# function and no non-empty BASH_ENV, ENV, SHELLOPTS, BASHOPTS or PS4, each of
# which can run code or change behaviour inside a bash (G6), and no non-empty
# LD_PRELOAD, LD_AUDIT or LD_LIBRARY_PATH, which load code into it before
# bash runs (-p does not drop them). Unreadable: refused.
parent_environ_clean() {
  local -a envs=()
  local e
  [[ -r "$1/environ" ]] || return 1
  mapfile -d '' -t envs < "$1/environ" 2>/dev/null || return 1
  for e in ${envs[@]+"${envs[@]}"}; do
    case "$e" in
      BASH_FUNC_*) return 1 ;;
      BASH_ENV=?*|ENV=?*|SHELLOPTS=?*|BASHOPTS=?*|PS4=?*) return 1 ;;
      LD_PRELOAD=?*|LD_AUDIT=?*|LD_LIBRARY_PATH=?*) return 1 ;;
    esac
  done
  return 0
}

# parent_is_gate_proc: the /proc arm, for Linux. Deny by default (AZ-1). The
# immediate parent must be a root-owned bash, not writable by this user, whose
# argv is exactly [bash, -p, <physical path of the gate beside this
# directory>, ...], whose descriptor 255 is that gate, and whose environment
# is clean (G6). This is the only arm that reads /proc; the Darwin arm below
# establishes the same five facts from the kernel's own records instead.
parent_is_gate_proc() {
  local proc="/proc/$PPID" rp st gate gate_real exe meta
  [[ -n "$SELF_DIR" && -d "$proc" ]] || return 1
  parent_pid_matches || return 1
  rp="$(sys_tool realpath)" || return 1
  st="$(sys_tool stat)" || return 1
  gate="$SELF_DIR/../autodrive_merge_gate.sh"
  [[ -f "$gate" ]] || return 1
  gate_real="$("$rp" -e -- "$gate" 2>/dev/null)" && [[ "$gate_real" == /* ]] || return 1
  local -a pargv=()
  mapfile -d '' -t pargv < "$proc/cmdline" 2>/dev/null || return 1
  (( ${#pargv[@]} >= 3 )) || return 1
  [[ "${pargv[1]}" == -p && "${pargv[2]}" == "$gate_real" ]] || return 1
  [[ "$proc/fd/255" -ef "$gate_real" ]] || return 1
  exe="$("$rp" -e -- "$proc/exe" 2>/dev/null)" && [[ -n "$exe" ]] || return 1
  [[ "${exe##*/}" == bash ]] || return 1
  meta="$("$st" -L -c '%u %a' -- "$exe" 2>/dev/null)" || return 1
  [[ "$meta" =~ ^0\ ([0-7]{3,4})$ ]] || return 1
  (( (8#${BASH_REMATCH[1]} & 8#022) == 0 )) || return 1
  (( EUID == 0 )) || [[ ! -w "$exe" ]] || return 1
  parent_environ_clean "$proc" || return 1
  # The parent may have exited while it was being read.
  parent_pid_matches || return 1
  return 0
}

# --------------------------------------------------------------------------
# The Darwin arm (#1646). macOS has no /proc, so each of the five facts above
# is established from a kernel-maintained record read through a root-owned
# tool at an absolute path: the pid table (ps), the open-file table and the
# virtual-memory mappings (lsof). Every helper here returns 0 only on
# positive establishment and 1 on everything else -- a missing tool, empty
# output, one line too many, a parse surprise, a parent that exited. "Could
# not tell" must be indistinguishable from "false" (AZ-1).
#
# bash 3.2 is the only bash macOS ships, so there is no mapfile, no `read -d`,
# no associative array and no `${x,,}` below, and `stat` is the BSD one.
# --------------------------------------------------------------------------

# The bash the gate must be run by on macOS, pinned by path and then by inode
# through fact (d). Linux compares the basename instead, because distributions
# put bash in several places.
#
# SEC-A8: this is the anchor of the whole fact (e) argument on macOS. Both
# halves of that argument -- that dyld strips DYLD_* before this process ever
# starts, and that ps withholds the parent's environment so the shim reads its
# own inherited one instead -- hold because the parent's executable is a
# SIP-protected platform binary. Repointing this at a bash outside a
# SIP-protected root (a Homebrew or nix bash) would remove both without
# changing a line of the checks below, and nothing here would notice. The
# shim's #! line, SHIM_INTERPRETER in merge_guard.rs and this constant must
# therefore agree, and the test that holds the three together --
# the_shim_and_the_launch_check_pin_the_same_interpreter -- is deliberate.
SHIM_BASH='/bin/bash'
GATE_REAL=""
PS_FIELD=""

# host_is_darwin: `uname -s` is exactly Darwin. Tried BEFORE /proc is looked
# at (SEC-11), so a forged /proc on a Mac cannot preempt the real check; a
# missing or unreadable uname answers "not Darwin", which falls through to the
# /proc arm and is refused there.
host_is_darwin() {
  local un out
  un="$(sys_tool uname)" || return 1
  out="$("$un" -s 2>/dev/null)" || return 1
  [[ "$out" == Darwin ]]
}

# ps_field <pid> <keyword>: sets PS_FIELD from `ps -o <keyword>=`. The keyword
# is a literal from a fixed set, never interpolated from anything the caller
# of gh controls. -ww stops ps truncating a wide argv, which would otherwise
# make the subtraction in fact (b) read a short argv as a complete one.
# Exactly one non-empty line, or failure.
ps_field() {
  local pid="$1" key="$2" ps out line n=0
  case "$key" in
    ppid|comm|args) ;;
    *) return 1 ;;
  esac
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  ps="$(sys_tool ps)" || return 1
  out="$("$ps" -ww -p "$pid" -o "$key=" 2>/dev/null)" || return 1
  PS_FIELD=""
  while IFS= read -r line; do
    n=$((n + 1))
    PS_FIELD="$line"
  done <<< "$out"
  (( n == 1 )) || return 1
  [[ -n "$PS_FIELD" ]] || return 1
  return 0
}

# gate_physical_darwin: sets GATE_REAL to the physical path of the gate beside
# this directory, computed the same way step-03 computes GATE_PHYS -- `cd -P`
# the directory, then the name -- so macOS's /var -> /private/var symlink
# cannot make the two disagree. No realpath: the BSD one has no -e.
#
# A path holding whitespace or a backslash is refused. ps gives argv as one
# space-joined string, so such a path cannot be recovered from it, and a guess
# is not a fact. This costs no security -- facts (c) and (d) prove the file and
# the interpreter independently -- but it does mean an AMPLIHACK_HOME with a
# space in it cannot merge on macOS, which the reference doc records.
gate_physical_darwin() {
  local dir
  [[ -n "$SELF_DIR" ]] || return 1
  dir="$(builtin cd -P -- "$SELF_DIR/.." 2>/dev/null && builtin pwd -P)" || return 1
  [[ "$dir" == /* ]] || return 1
  GATE_REAL="$dir/autodrive_merge_gate.sh"
  [[ -f "$GATE_REAL" ]] || return 1
  case "$GATE_REAL" in
    *[[:space:]]*|*\\*) return 1 ;;
  esac
  return 0
}

# Fact (a): the pid the kernel reports as this process's parent is still
# $PPID, so a shim whose parent exited and whose pid was reused is never
# judged by a stranger (G12). `ps -o ppid=` pads to the column width.
parent_pid_matches_darwin() {
  local v
  ps_field "$$" ppid || return 1
  v="$PS_FIELD"
  v="${v#"${v%%[![:space:]]*}"}"
  v="${v%"${v##*[![:space:]]}"}"
  [[ "$v" =~ ^[0-9]+$ && "$v" == "$PPID" ]]
}

# Fact (b): the parent's argv is [<argv0>, -p, <gate>, ...].
#
# `args` alone is NOT enough, and a simplification that dropped the comm
# subtraction below would reopen a confirmed hole. argv[0] is attacker-set
# (`exec -a`) and `args` is the argv joined with single spaces, so a parent run
# as `exec -a "/bin/bash -p <gate>" /bin/bash <gate>` reads, in `args` alone,
# exactly like the gate: the text the check looks for is sitting inside
# argv[0]. Subtracting argv[0] from the front leaves `<gate>`, not
# `-p <gate>`, and the merge is refused.
#
# Every request-derived string is used as a LITERAL, quoted, and sits on the
# left of the comparison. `set -f` turns off pathname expansion but NOT
# pattern matching in ${v#...}, case or [[ == ]], so an unquoted argv[0]
# holding `*` would strip a different amount of text than it occupies.
# argv[0]'s own content is deliberately not trusted, exactly as the /proc arm
# ignores pargv[0]: only -p and the gate path are facts.
parent_argv_is_gate_darwin() {
  local comm args rest
  ps_field "$PPID" comm || return 1
  comm="$PS_FIELD"
  ps_field "$PPID" args || return 1
  args="$PS_FIELD"
  [[ "$args" == "$comm"* ]] || return 1
  rest="${args#"$comm"}"
  # What is left still begins with the one space that separated argv[0] from
  # argv[1]. Requiring it also refuses an argv[0] that macOS's ps omits
  # entirely, which an empty argv[0] makes indistinguishable from
  # `exec -a "-p" /bin/bash <gate>` -- an attack shape.
  [[ "$rest" == " "* ]] || return 1
  rest="${rest# }"
  [[ "$rest" == "-p $GATE_REAL" || "$rest" == "-p $GATE_REAL "* ]] || return 1
  return 0
}

# txt_entry_ok <path>: a file the parent has mapped is either /bin/bash itself
# or a system library under a SIP-protected root, and in both cases is owned
# by root, not group- or other-writable, and not writable by this user. This
# is a property check rather than a literal {bash, dyld} allowlist, so a
# future macOS that maps one more system library does not break the feature,
# while an attacker's dylib under /tmp or $HOME fails all of it.
#
# COUPLING (SEC-V4): the prefix allowlist below is only sound because the
# caller, parent_files_are_gate_darwin, has already rejected any name that is
# relative or that contains a `..` component. /usr/lib/../../tmp/evil.dylib
# matches `/usr/lib/*` and is stopped by nothing in this function. Neither
# check may be moved after the other, and neither may be dropped on the
# grounds that the other one looks sufficient.
txt_entry_ok() {
  local st meta
  if ! [[ "$1" -ef "$SHIM_BASH" ]]; then
    case "$1" in
      /usr/lib/*|/System/*) ;;
      *) return 1 ;;
    esac
  fi
  st="$(sys_tool stat)" || return 1
  meta="$("$st" -L -f '%u %Lp' -- "$1" 2>/dev/null)" || return 1
  [[ "$meta" =~ ^0\ ([0-7]{3,4})$ ]] || return 1
  (( (8#${BASH_REMATCH[1]} & 8#022) == 0 )) || return 1
  (( EUID == 0 )) || [[ ! -w "$1" ]] || return 1
  return 0
}

# Facts (c), (d) and the mapped-library half of (e), from one lsof call.
#
# `-F fn` is a RECORD stream: a leading p<pid> line, then an f<fd> line and
# the n<name> line belonging to it. It must be parsed as records, never
# scanned line by line. A line-oriented scan would bind an n name from one
# record to the f255 of another, so ANY descriptor the parent happens to hold
# on the gate file would satisfy fact (c) -- `exec 7<gate` arranges that in one
# word -- where the fact is specifically about descriptor 255, the one bash
# keeps open on the script it is executing.
parent_files_are_gate_darwin() {
  local out line fd name pending fd255="" n255=0 ntxt=0 nbash=0
  # One call, and always with -n and -P: no host or service name resolution,
  # so no DNS or service lookup -- no network egress from inside a security
  # check, and no stall on a slow resolver (SEC-DATA-2). A missing lsof leaves
  # the inner substitution empty, which cannot be executed: refused (AZ-1).
  out="$("$(sys_tool lsof)" -n -P -p "$PPID" -a -d 255,txt -F fn 2>/dev/null)" || return 1
  pending=""
  while IFS= read -r line; do
    case "$line" in
      p*) continue ;;
      f*)
        [[ -z "$pending" ]] || return 1
        pending="${line#f}"
        [[ -n "$pending" ]] || return 1
        ;;
      n*)
        [[ -n "$pending" ]] || return 1
        fd="$pending"
        pending=""
        name="${line#n}"
        # Must stay ahead of txt_entry_ok's /usr/lib and /System prefix
        # allowlist: that allowlist accepts /usr/lib/../../tmp/evil.dylib,
        # and this is the only thing that does not (SEC-V4).
        [[ "$name" == /* ]] || return 1
        case "$name" in
          *'/../'*|*/..) return 1 ;;
        esac
        if [[ "$fd" == "255" ]]; then
          n255=$((n255 + 1))
          fd255="$name"
        elif [[ "$fd" == "txt" ]]; then
          ntxt=$((ntxt + 1))
          txt_entry_ok "$name" || return 1
          [[ "$name" -ef "$SHIM_BASH" ]] && nbash=$((nbash + 1))
        else
          return 1
        fi
        ;;
      *) return 1 ;;
    esac
  done <<< "$out"
  [[ -z "$pending" ]] || return 1
  (( n255 == 1 )) || return 1
  [[ "$fd255" -ef "$GATE_REAL" ]] || return 1
  (( ntxt >= 1 && nbash >= 1 )) || return 1
  return 0
}

# The environment half of fact (e), read from the snapshot this shim took of
# its own inherited environment before the prologue unset anything. Presence,
# not value, is the test: bash rewrites an injected SHELLOPTS or BASHOPTS but
# keeps it exported, so a value comparison would miss it. Each name is
# anchored at the start of a line, so a value holding a newline can only ADD a
# forbidden-looking line (refuse) and can never hide a real entry.
#
# This is the one fact macOS observes at a different point from Linux: the
# shim's inherited environment rather than a snapshot of the parent's execve
# environment. `ps -E` withholds the environment of a process whose executable
# is a SIP-protected platform binary; /bin/bash is one, and the interpreter
# check pins the parent to it by inode, so the one process we need to read is
# exactly the case ps withholds. (An ordinary binary is not withheld, so this
# follows the executable, not ps.) launchctl procinfo needs root, and
# vmmap/sample need a debugging entitlement. That makes the divergence rest on
# SIP, like the DYLD_* argument below: SHIM_BASH is what anchors it, and
# pointing it at a bash outside a SIP-protected root would quietly remove
# both. The difference and what it does not stop are recorded on #1646 and in
# docs/reference/auto-drive-to-merge.md.
own_environ_clean() {
  local line
  [[ -n "$GUARD_ENV" ]] || return 1
  while IFS= read -r line; do
    case "$line" in
      BASH_FUNC_*) return 1 ;;
      BASH_ENV=?*|ENV=?*|SHELLOPTS=?*|BASHOPTS=?*|PS4=?*) return 1 ;;
      LD_PRELOAD=?*|LD_AUDIT=?*|LD_LIBRARY_PATH=?*) return 1 ;;
      DYLD_INSERT_LIBRARIES=?*|DYLD_LIBRARY_PATH=?*) return 1 ;;
    esac
  done <<< "$GUARD_ENV"
  return 0
}

# parent_is_gate_darwin: the same five conjuncts as the /proc arm, in the same
# order, with fact (a) read again at the end so a parent that exited while it
# was being read is not judged by whoever inherited its pid.
parent_is_gate_darwin() {
  gate_physical_darwin || return 1
  parent_pid_matches_darwin || return 1
  parent_argv_is_gate_darwin || return 1
  parent_files_are_gate_darwin || return 1
  own_environ_clean || return 1
  parent_pid_matches_darwin || return 1
  return 0
}

# parent_is_gate: pick the arm the host can actually support. Darwin is tried
# first (SEC-11): it is free to do, it keeps a forged /proc on a Mac from
# preempting the real check, and because host_is_darwin requires `uname -s` to
# be exactly Darwin, no non-Darwin host can reach the arm below it. A host
# that is neither Darwin nor a readable /proc has no parent check at all, and
# parent_is_gate_proc refuses there. `amplihack recipe run` stops such a run
# before its first step (check_guard_host, #1644).
parent_is_gate() {
  if host_is_darwin; then
    parent_is_gate_darwin
    return $?
  fi
  parent_is_gate_proc
}

# to_lower <text>: sets LOWER. macOS ships /bin/bash 3.2, where `${x,,}` is a
# bad substitution that would end the shim on every `gh api` call, so older
# bash lowercases through the system tr instead.
to_lower() {
  if (( BASH_VERSINFO[0] >= 4 )); then
    LOWER="${1,,}"
  else
    local tr
    tr="$(sys_tool tr)" || { LOWER="$1"; return 1; }
    LOWER="$(printf '%s' "$1" | "$tr" '[:upper:]' '[:lower:]'; printf x)"
    LOWER="${LOWER%x}"
  fi
}

# names_merge <text>: mentions merge or graphql, in any case.
names_merge() {
  local lc
  to_lower "$1" || return 0
  lc="$LOWER"
  [[ "$lc" == *merge* || "$lc" == *graphql* ]]
}

# is_merge_endpoint <endpoint>: a REST merge endpoint, or an endpoint that
# mentions pull or merge in a form the guard will not resolve (SR-3).
is_merge_endpoint() {
  local e seg
  to_lower "$1" || return 0
  e="$LOWER"
  local -a segs=()
  if [[ "$e" == *pull* || "$e" == *merge* ]]; then
    [[ "$e" == *%* ]] && return 0
    [[ "$e" == *\\* ]] && return 0
    [[ "$e" == *[[:space:][:cntrl:]]* ]] && return 0
    IFS=/ read -r -a segs <<< "$e"
    for seg in "${segs[@]}"; do
      [[ "$seg" == . || "$seg" == .. ]] && return 0
    done
  fi
  if [[ "$e" =~ ^[a-z][a-z0-9+.-]*://[^/]*(.*)$ ]]; then
    e="${BASH_REMATCH[1]}"
  fi
  e="${e%%[?#]*}"
  while [[ "$e" == *//* ]]; do e="${e//\/\//\/}"; done
  e="${e#/}"
  [[ "$e" == api/v3/* ]] && e="${e#api/v3/}"
  e="${e%/}"
  # gh expands {branch} to the current branch, unescaped, so it may carry
  # slashes that complete a merge path: never resolved, refused.
  [[ "$e" == *'{branch}'* ]] && return 0
  # GitHub serves every repo route under repositories/<id>/ as well.
  [[ "$e" =~ ^repositories/[^/]+/(.*)$ ]] && e="repos/_/_/${BASH_REMATCH[1]}"
  [[ "$e" =~ ^repos/[^/]+/[^/]+/pulls/[^/]+/merge$ || "$e" =~ ^repos/[^/]+/[^/]+/merges$ ]]
}

CLASS=""
LOWER=""
MUTATION_RE='(^|[^a-z0-9_])(mergepullrequest|enablepullrequestautomerge|enqueuepullrequest|mergebranch)([^a-z0-9_]|$)'

classify_pr() {
  while (( $# > 0 )); do
    case "$1" in
      -R|--repo) shift 2 || return 0 ;;
      -*) shift ;;
      merge) CLASS='gh pr merge'; return 0 ;;
      *) return 0 ;;
    esac
  done
}

# is_graphql_endpoint <endpoint>: any endpoint that mentions graphql, in any
# spelling: bare, /graphql, graphql?, a full https:// URL, GHES /api/graphql.
# Spellings are never listed one by one; a REST endpoint that merely names a
# repo "graphql" is treated as GraphQL too, which fails closed.
is_graphql_endpoint() {
  local e
  to_lower "$1" || return 0
  e="$LOWER"
  [[ "$e" == *graphql* ]]
}

# classify_api: a flag consumes the next argument only when it is an exact
# token that takes a value (SR-2). Order: mutation, unreadable, endpoint.
# A query is unreadable when any argument reads a file or stdin: --input, or
# `=@` anywhere, including inside combined short flags such as -iF k=@f.
classify_api() {
  local -a pos=() all=("$@")
  local t lc unreadable=0
  while (( $# > 0 )); do
    t="$1"; shift
    case "$t" in
      -X|--method|-H|--header|-f|--raw-field|-F|--field|--input|-q|--jq|-t|--template|--hostname|-p|--preview|--cache)
        [[ "$t" == --input ]] && unreadable=1
        (( $# > 0 )) && shift ;;
      --input=*) unreadable=1 ;;
      -*) ;;
      *) pos+=("$t") ;;
    esac
  done
  for t in ${all[@]+"${all[@]}"}; do
    to_lower "$t" || { CLASS='gh api graphql unreadable query'; return 0; }
    lc="$LOWER"
    if [[ "$lc" =~ $MUTATION_RE ]]; then CLASS='gh api graphql merge mutation'; return 0; fi
    [[ "$t" == *=@* ]] && unreadable=1
  done
  for t in ${pos[@]+"${pos[@]}"}; do
    if is_graphql_endpoint "$t" && (( unreadable )); then
      CLASS='gh api graphql unreadable query'; return 0
    fi
  done
  for t in ${pos[@]+"${pos[@]}"}; do
    if is_merge_endpoint "$t"; then CLASS='gh api merge endpoint'; return 0; fi
  done
}

# classify_alias_cmd: `alias set` or `alias import` that would define a merge.
classify_alias_cmd() {
  local sub="" t content
  local -a pos=()
  for t in "$@"; do
    [[ "$t" == -* && "$t" != - ]] && continue
    pos+=("$t")
  done
  (( ${#pos[@]} > 0 )) && sub="${pos[0]}"
  case "$sub" in
    set)
      # A `$N` placeholder takes words at call time, so `pr $1` + `merge`
      # would merge: refused, like an expansion that names a merge.
      for t in "${pos[@]:2}"; do
        if [[ "$t" == - || "$t" == *'$'* ]] || names_merge "$t"; then CLASS='gh alias'; return 0; fi
      done ;;
    import)
      t="${pos[1]-}"
      if [[ -z "$t" || "$t" == - || ! -f "$t" ]]; then CLASS='gh alias'; return 0; fi
      content="$(< "$t")" || { CLASS='gh alias'; return 0; }
      names_merge "$content" && CLASS='gh alias' ;;
  esac
  return 0
}

# classify_extension_cmd: an extension runs its own code, which can merge
# without calling back into this guard, so installing, upgrading or running
# one is refused. Listing, removing, searching and creating are not.
classify_extension_cmd() {
  local t
  for t in "$@"; do
    [[ "$t" == -* ]] && continue
    case "$t" in
      install|upgrade|exec) CLASS='gh extension' ;;
    esac
    return 0
  done
  return 0
}

# classify_alias_use <word> <args...>: a word that is not a built-in command
# is an alias, an extension or a command newer than the allowlist. An alias
# name is compared as a literal string, never a pattern; a word that names no
# alias is refused as an unknown command or extension.
classify_alias_use() {
  local cmd="$1" out line exp
  shift
  out="$("$REAL_GH" alias list 2>/dev/null)" || { CLASS='gh alias'; return 0; }
  while IFS= read -r line; do
    [[ "${line%%:*}" == "$cmd" ]] || continue
    exp="${line#*:}"
    exp="${exp#"${exp%%[![:space:]]*}"}"
    if [[ "$exp" == \'*\' || "$exp" == \"*\" ]]; then exp="${exp:1:${#exp}-2}"; fi
    # Placeholders and quotes are filled in or split by gh, not here: an
    # expansion holding either cannot be classified, so it is refused.
    if [[ "$exp" == *[\$\'\"]* ]]; then CLASS='gh alias'; return 0; fi
    if [[ "$exp" == '!'* ]]; then
      names_merge "$exp" && CLASS='gh alias'
      return 0
    fi
    local -a words=()
    read -r -a words <<< "$exp"
    classify 0 ${words[@]+"${words[@]}"} "$@"
    return 0
  done <<< "$out"
  CLASS="$UNKNOWN_CLASS"
  return 0
}

# classify <allow_alias> <gh args...>: sets CLASS to the refusal label of a
# merge form, or leaves it empty.
classify() {
  local allow_alias="$1"
  shift
  while (( $# > 0 )); do
    case "$1" in
      -R|--repo|--hostname) shift 2 || return 0 ;;
      -*) shift ;;
      *) break ;;
    esac
  done
  (( $# > 0 )) || return 0
  local cmd="$1"
  shift
  case "$cmd" in
    pr) classify_pr "$@" ;;
    api) classify_api "$@" ;;
    alias) classify_alias_cmd "$@" ;;
    extension|extensions|ext) classify_extension_cmd "$@" ;;
    # Built-in commands that cannot merge, checked against gh 2.102. Fails safe: any
    # other word is an alias (checked below), an extension, or a command a
    # newer gh added; the last two are refused with their own message, which
    # names this list. A new gh command that cannot merge belongs here.
    accessibility|actions|agent|agents|agent-task|agent-tasks|at|attestation|auth|browse|cache|codespace|completion|config|copilot|cs|discussion|environment|exit-codes|formatting|gist|gpg-key|help|issue|label|licenses|mintty|org|preview|project|reference|release|repo|rs|ruleset|run|search|secret|skill|skills|ssh-key|status|telemetry|variable|version|workflow) ;;
    *)
      if [[ "$allow_alias" == 1 ]]; then
        classify_alias_use "$cmd" "$@"
      else
        CLASS="$UNKNOWN_CLASS"
      fi ;;
  esac
  return 0
}

if ! find_real_gh; then
  printf 'amplihack gh-merge-guard: real gh not found on PATH\n' >&2
  exit 127
fi

classify 1 "$@"
if [[ -n "$CLASS" ]] && ! parent_is_gate; then
  refuse "$CLASS"
fi
exec "$REAL_GH" "$@"
