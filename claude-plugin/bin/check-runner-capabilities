#!/bin/sh
# Native semantic validation; Python and Node are optional installation tools.
# Arguments: exact runner executable, then optional managed receipt arguments.
[ "$#" -ge 1 ] || { echo 'runner executable required' >&2; exit 1; }
runner=$1
shift
validator=$(command -v amplihack 2>/dev/null)
validator_help=
if [ -n "$validator" ]; then
  validator_help=$("$validator" internal validate-recipe-runner --help 2>/dev/null) || validator_help=
fi
case "$validator_help" in
  *--require-capability*) ;;
  *)
  # An older user-owned CLI must remain untouched. Build a private validator
  # from this plugin checkout under its existing Cargo-only contract.
  command -v cargo >/dev/null 2>&1 || { echo 'cargo required to build current runner validator' >&2; exit 1; }
  target="${data:?plugin data directory required}/validator-target"
  (cd "${root:?plugin source root required}" && CARGO_TARGET_DIR="$target" cargo build --release --locked --bin amplihack) || exit 1
  validator="$target/release/amplihack"
  ;;
esac
exec "$validator" internal validate-recipe-runner --provider claude --require-capability durable_recovery_v1 --binary "$runner" "$@"
