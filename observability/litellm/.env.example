# Generate each local password/key independently. Never commit the populated .env.
# POSTGRES_PASSWORD must be alphanumeric because it is embedded in DATABASE_URL.
# `openssl rand -hex 32` produces a compatible value.
LITELLM_MASTER_KEY=
# Generate once and retain permanently. Rotating this key makes encrypted
# database credentials unreadable.
LITELLM_SALT_KEY=
POSTGRES_PASSWORD=
GF_SECURITY_ADMIN_PASSWORD=
# Optional virtual-key controls. Leave all blank for no budget or rate limit.
AMPLIHACK_KEY_MAX_BUDGET=
AMPLIHACK_KEY_BUDGET_DURATION=
AMPLIHACK_KEY_REQUESTS_PER_MINUTE=

# LiteLLM provider/model syntax, for example:
#   anthropic/claude-sonnet-4-5-20250929
#   openai/gpt-5.4
#   azure/your-deployment
LITELLM_UPSTREAM_MODEL=anthropic/claude-sonnet-4-5-20250929

# Set the credential required by LITELLM_UPSTREAM_MODEL.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AZURE_API_KEY=
AZURE_API_BASE=
AZURE_API_VERSION=

# Optional external OpenTelemetry export. Use with docker-compose.external-otel.yml.
AMPLIHACK_EXTERNAL_OTLP_ENDPOINT=
AMPLIHACK_EXTERNAL_OTLP_AUTHORIZATION=
