{
  "annotations": {"list": []},
  "editable": false,
  "panels": [
    {
      "title": "Service availability",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {"expr": "up{job=~\"litellm-gateway|otel-collector\"}", "legendFormat": "{{job}}"}
      ]
    },
    {
      "title": "Prometheus scrape duration",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {"expr": "scrape_duration_seconds{job=~\"litellm-gateway|otel-collector\"}", "legendFormat": "{{job}}"}
      ]
    },
    {
      "title": "Gateway request rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {"expr": "sum(rate(litellm_proxy_total_requests_metric_total[5m]))", "legendFormat": "requests/s"}
      ]
    },
    {
      "title": "Gateway failure rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {"expr": "sum(rate(litellm_proxy_failed_requests_metric_total[5m]))", "legendFormat": "failures/s"}
      ]
    }
  ],
  "schemaVersion": 41,
  "tags": ["amplihack", "litellm"],
  "templating": {"list": []},
  "time": {"from": "now-30m", "to": "now"},
  "title": "External LiteLLM gateway",
  "uid": "amplihack-litellm",
  "version": 1
}
